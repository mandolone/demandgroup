# Copy to an ignored .env file OUTSIDE docs/ and public/. Use real values only in Supabase secrets.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically to deployed Edge Functions.
EXCLUSIVE_ALLOWED_ORIGINS=https://demandgroup.smokeandthink.com
EXCLUSIVE_TURNSTILE_HOSTNAMES=demandgroup.smokeandthink.com
TURNSTILE_SECRET_KEY=REPLACE_IN_SUPABASE_ONLY
EXCLUSIVE_RATE_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
EXCLUSIVE_CLEANUP_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
